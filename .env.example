# Copy to .env (local dev) / .env.staging / .env.production and fill in.
# Never commit real values — .env* (except this file) is gitignored.

# Postgres connection string. Use a separate database per environment
# (local, staging, production) — never point staging/prod at the same DB.
DATABASE_URL="postgresql://covered:covered@localhost:5432/covered_dev"

# Random 32+ byte secret used to sign session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-real-secret"

# Which environment this is running as — affects nothing yet in Phase 0,
# but downstream phases (payments, verification) branch on it to avoid
# calling live providers from staging.
APP_ENV="development" # development | staging | production

# --- Configurable commercial figures ---
# All illustrative placeholders per CLAUDE.md — override per environment,
# never hardcode into application code. See src/config/business-rules.ts.
COMMISSION_RATE="0.15"
HIRE_FEE_RATE_TIER_1="0.20"   # < HIRE_FEE_TIER_1_MAX_SHIFTS completed shifts
HIRE_FEE_RATE_TIER_2="0.12"   # < HIRE_FEE_TIER_2_MAX_SHIFTS completed shifts
HIRE_FEE_RATE_TIER_3="0.05"   # otherwise
HIRE_FEE_TIER_1_MAX_SHIFTS="15"
HIRE_FEE_TIER_2_MAX_SHIFTS="40"
EXTENDED_HIRE_WEEKS="8"
MIN_SHIFTS_FOR_SCORE="10"

# --- Reliability Score formula constants (spec §2.1) ---
# Also illustrative — see src/lib/scoring.ts for what each one fills in
# and why the spec doesn't give an exact number for it.
SCORE_RECENT_WINDOW_DAYS="90"
SCORE_RECENCY_WEIGHT="3"
LATE_CANCELLATION_NOTICE_HOURS="4"
PUNCTUALITY_LATE_CAP_MINUTES="60"
CONFIDENCE_SATURATION_SHIFTS="30"

# --- App URL (for Stripe redirect targets) ---
# Must be an absolute, publicly reachable URL in staging/production —
# Stripe redirects the browser here after Connect onboarding and
# Checkout. Localhost is fine for local dev.
APP_URL="http://localhost:3000"

# --- Stripe (Phase 3 — payments) ---
# From your Stripe Dashboard, test mode, until there's a real account:
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/webhooks/stripe`)
# for local dev, or the Dashboard's webhook endpoint settings in staging/production.
STRIPE_WEBHOOK_SECRET=""
