// Covered — Phase 0 data model.
// Source of truth: reference/docs/covered-technical-spec.md §1 and §8
// (§8.3 corrects VenueProfile -> Venue/VenueMember; §8.6 adds the
// "rejected" verification path; §8.8 adds versioned TermsAcceptance).
// Do not add fields here that aren't in the spec without updating the
// spec first — this file and the TS interfaces in §1 must stay in sync.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums --------------------------------------------------------------

enum UserRole {
  worker
  venue_admin
  admin
}

enum WorkerRole {
  Bartender
  WaiterWaitress
  HeadChef
  SousChef
  ChefDePartie
  CommisChef
  KitchenPorter
  EventSteward
  Housekeeper
  Barista
  FrontOfHouseManager
}

enum ReliabilityTier {
  rising
  reliable
  top_rated
}

enum VerificationStatus {
  pending
  verified
  rejected
}

enum DbsStatus {
  pending
  verified
  rejected
  not_required
}

enum CertType {
  food_hygiene_l2
  food_hygiene_l3
  personal_licence
  silver_service
  first_aid
  sia_badge
  barista_l1
  barista_l2
  cellar_management
  coshh
  wine_basics
  allergen_trained
}

enum CertStatus {
  pending
  verified
  expired
}

enum SubscriptionTier {
  pay_as_you_go
  growth
  enterprise
}

enum VenueMemberRole {
  owner
  manager
  staff
}

enum ShiftStatus {
  open
  offered
  accepted
  declined
  confirmed
  completed
  no_show
  cancelled_by_worker
  cancelled_by_venue
}

enum DisputeRaisedBy {
  worker
  venue
}

enum DisputeTargetType {
  shift_feedback
  venue_feedback
}

enum DisputeCheckType {
  objective
  subjective
}

enum DisputeStatus {
  pending_review
  resolved_upheld
  resolved_excluded
}

enum FeeOption {
  conversion_fee
  extended_hire
}

enum HireRequestStatus {
  pending_worker_response
  accepted
  declined
}

enum AdminRole {
  reviewer
  ops_manager
  super_admin
}

// Not in spec §1 — Phase 3 (§8.1) needs a record of where each shift's
// money is in the charge-then-transfer flow. "pending_setup" covers a
// shift completing before either side has finished Stripe onboarding —
// the booking loop stays usable either way; payment catches up once
// both sides are ready (retry via POST /shifts/:id/charge).
enum PaymentStatus {
  pending_setup
  charging
  charged
  paid_out
  failed
}

// --- Core identity --------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  phone        String?
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  // Not in spec §1 — spec §8.2 lists "suspend a worker or venue account"
  // as an admin endpoint, which needs somewhere to record it. Login and
  // search both check this (src/lib/auth.ts, /api/candidates).
  suspendedAt     DateTime?
  suspendedReason String?

  workerProfile     WorkerProfile?
  venueMemberships  VenueMember[]
  adminUser         AdminUser?
  termsAcceptances  TermsAcceptance[]

  @@map("users")
}

// --- Worker side ------------------------------------------------------------

model WorkerProfile {
  id                    String              @id @default(uuid())
  userId                String              @unique
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  primaryRole           WorkerRole
  yearsExperience       Float
  hourlyRate            Float
  postcode              String
  lat                   Float?
  lng                   Float?
  maxTravelDistanceMi   Float
  availability          Json // WeeklyAvailability, see src/lib/types.ts
  rightToWorkStatus     VerificationStatus  @default(pending)
  idVerificationStatus  VerificationStatus  @default(pending)
  dbsStatus             DbsStatus           @default(not_required)
  reliabilityScore      Float?
  reliabilityTier       ReliabilityTier     @default(rising)
  shiftsCompleted       Int                 @default(0)
  noShows               Int                 @default(0)
  consentGivenAt        DateTime?
  // bankAccountConnected is the spec §1 field; it doubles here as
  // "Stripe Connect onboarding is complete" (charges_enabled &&
  // payouts_enabled on the account), kept in sync by the account.updated
  // webhook. stripeConnectAccountId is the Stripe-specific pointer
  // needed to actually create transfers — not in the original spec, but
  // Phase 3 (§8.1) can't move money without it.
  bankAccountConnected  Boolean             @default(false)
  stripeConnectAccountId String?            @unique
  createdAt             DateTime            @default(now())

  // Not in spec §1 — Phase 4 (§8.1) needs somewhere to keep the
  // provider-specific state and submission timestamps behind the three
  // VerificationStatus fields above. idVerification goes through Persona
  // (real API, self-serve sandbox) — originally built against Onfido,
  // switched after Onfido's Entrust acquisition moved API access behind
  // a sales-led enterprise signup with no self-serve sandbox. rightToWork
  // and dbs have no self-serve API in the real world — the Home Office
  // RTW check is a manual gov.uk share-code lookup, and DBS checks
  // require a registered umbrella-body relationship — so both stay
  // "worker submits, admin confirms" per the verification doc's data
  // (§1) and CLAUDE.md's allowance for partly-manual verification during
  // a pilot.
  personaInquiryId             String?   @unique
  idVerificationSubmittedAt   DateTime?
  rightToWorkShareCode        String?
  rightToWorkDob               DateTime?
  rightToWorkSubmittedAt      DateTime?
  dbsApplicationRef           String?
  dbsSubmittedAt               DateTime?

  certifications  Certification[]
  shifts          Shift[]
  favouritedBy    Favourite[]
  hireRequests    HireRequest[]
  cv              WorkerCv?

  @@map("worker_profiles")
}

model Certification {
  id          String        @id @default(uuid())
  workerId    String
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type        CertType
  status      CertStatus    @default(pending)
  expiryDate  DateTime?
  verifiedAt  DateTime?

  @@index([workerId])
  @@map("certifications")
}

// Not in spec — a CV is deliberately optional supplementary info, not
// part of the core matching signal (the product's own pitch, per the
// prototypes' onboarding copy, is the Reliability Score "not a CV
// claim"). Kept in its own table rather than on WorkerProfile directly:
// most queries fetch a WorkerProfile without a `select`, and a Bytes
// column there would get pulled into every one of them.
model WorkerCv {
  id         String        @id @default(uuid())
  workerId   String        @unique
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  fileName   String
  mimeType   String
  data       Bytes
  uploadedAt DateTime      @default(now())

  @@map("worker_cvs")
}

// --- Venue side (corrected multi-user model, spec §8.3) -------------------

model Venue {
  id                String            @id @default(uuid())
  name              String
  postcode          String
  lat               Float?
  lng               Float?
  subscriptionTier  SubscriptionTier  @default(pay_as_you_go)
  trustScore        Float?
  trustTier         ReliabilityTier   @default(rising)
  createdAt         DateTime          @default(now())

  // Not in spec §1 — needed for Phase 3 (§8.1) commission collection.
  // stripeCustomerId is the Stripe Customer; the default payment method
  // is attached to that Customer on Stripe's side (set via the
  // checkout.session.completed webhook), so no separate field for it.
  stripeCustomerId  String?           @unique

  // Per-venue commission override (fraction, e.g. 0.10 for 10%). Null
  // means "use the platform default" (COMMISSION_RATE, see
  // src/config/business-rules.ts) — most venues should have no
  // override. Negotiated rates are a business decision, not something
  // a fixed global constant can express; CLAUDE.md requires commercial
  // figures like this stay configurable, not hardcoded.
  commissionRateOverride Float?

  members        VenueMember[]
  shifts         Shift[]
  favourites     Favourite[]
  hireRequests   HireRequest[]

  @@map("venues")
}

model VenueMember {
  id         String            @id @default(uuid())
  venueId    String
  venue      Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       VenueMemberRole
  invitedAt  DateTime          @default(now())
  joinedAt   DateTime?

  @@unique([venueId, userId])
  @@index([userId])
  @@map("venue_members")
}

// --- Booking loop -----------------------------------------------------------

model Shift {
  id                 String       @id @default(uuid())
  venueId            String
  venue              Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  workerId           String?
  worker             WorkerProfile? @relation(fields: [workerId], references: [id])
  role               WorkerRole
  date               DateTime
  startTime          String
  endTime            String
  hourlyRate         Float
  status             ShiftStatus  @default(open)
  distanceAtMatchMi  Float?
  offeredAt          DateTime?
  respondBy          DateTime?
  // Set when a worker cancels a confirmed shift inside the notice-period
  // threshold (spec §3.1) — the flag the reliability score reads to
  // count it against attendance. A cancellation outside the threshold,
  // or one initiated by the venue, never sets this and never touches
  // the score (two-sided accountability, scoring doc §6).
  lateCancellation   Boolean      @default(false)
  createdAt          DateTime     @default(now())

  shiftFeedback  ShiftFeedback?
  venueFeedback  VenueFeedback?
  payment        Payment?

  @@index([venueId])
  @@index([workerId])
  @@index([status])
  @@map("shifts")
}

// Not in spec §1 — see PaymentStatus above. One row per shift, created
// when the shift completes (§3.1: completion is the payment trigger too,
// by implication of "money actually moves" in §8.1's Phase 3 done-bar).
model Payment {
  id                     String        @id @default(uuid())
  shiftId                String        @unique
  shift                  Shift         @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  workerAmountCents      Int
  commissionAmountCents  Int
  totalAmountCents       Int
  currency               String        @default("gbp")
  status                 PaymentStatus @default(pending_setup)
  stripePaymentIntentId  String?
  stripeTransferId       String?
  failureReason          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@index([status])
  @@map("payments")
}

model ShiftFeedback {
  id                   String   @id @default(uuid())
  shiftId              String   @unique
  shift                Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  confirmedAttendance  Boolean
  onTime               Boolean
  minutesLate          Int?
  submittedAt          DateTime @default(now())

  @@map("shift_feedback")
}

model VenueFeedback {
  id                   String   @id @default(uuid())
  shiftId              String   @unique
  shift                Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  paidOnTime           Boolean
  breaksGiven          Boolean
  matchedDescription   Boolean
  comment              String?
  submittedAt          DateTime @default(now())

  @@map("venue_feedback")
}

// --- Disputes (human-in-the-loop only, spec §3.2 / §7) --------------------

model Dispute {
  id           String             @id @default(uuid())
  raisedBy     DisputeRaisedBy
  targetType   DisputeTargetType
  targetId     String
  reason       String
  note         String
  checkType    DisputeCheckType?
  evidence     String?
  status       DisputeStatus      @default(pending_review)
  resolvedAt   DateTime?
  resolvedBy   String? // AdminUser.id, once a human decides
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt // optimistic concurrency, spec §8.7

  @@index([status])
  @@index([checkType])
  @@map("disputes")
}

// --- Favourites / hire ------------------------------------------------------

model Favourite {
  id         String        @id @default(uuid())
  venueId    String
  venue      Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  workerId   String
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([venueId, workerId])
  @@map("favourites")
}

model HireRequest {
  id                        String             @id @default(uuid())
  venueId                   String
  venue                     Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  workerId                  String
  worker                    WorkerProfile      @relation(fields: [workerId], references: [id], onDelete: Cascade)
  proposedRoleTitle         String
  proposedSalary            Float
  proposedStartDate         DateTime
  feeOption                 FeeOption
  feeAmount                 Float?
  shiftsCompletedAtRequest  Int
  status                    HireRequestStatus  @default(pending_worker_response)
  respondedAt               DateTime?
  createdAt                 DateTime           @default(now())

  @@map("hire_requests")
}

// --- Admin / ops (spec §8.2) -----------------------------------------------

model AdminUser {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRole
  createdAt DateTime   @default(now())

  @@map("admin_users")
}

// Not in spec §1 — spec §8.2 requires every admin action write "an audit
// log entry (who, what, when, why)"; this is that log, scoped to what
// Phase 4 actually needs (verification overrides). The full admin panel
// (dispute resolution, account suspension) is Phase 5.
model AdminAuditLog {
  id         String   @id @default(uuid())
  adminId    String   // AdminUser.id
  action     String
  targetType String
  targetId   String
  reason     String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@map("admin_audit_log")
}

// --- Terms acceptance (spec §8.8) -------------------------------------------

model TermsAcceptance {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion  String
  acceptedAt    DateTime @default(now())

  @@index([userId])
  @@map("terms_acceptances")
}
